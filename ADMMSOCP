module ADMMSOCP

    using LinearAlgebra
    using SparseArrays
    using Printf

    # ==============================================================================
    # 1. STRUTTURE DATI (TYPES)
    # ==============================================================================

    struct SOCData
        Ind_Soc::Vector{Vector{Int}}   # Indici delle variabili vettoriali (x)
        Ind_t_Soc::Vector{Int}         # Indici delle variabili scalari (t)
        t_Soc::Vector{Float64}         # Valori fissi di t (se costanti)
    end
    # SOCData() = SOCData(Vector{Vector{Int}}[], Int[], Float64[])

    struct RSOCData
        Ind_x::Vector{Vector{Int}}
        Ind_u::Vector{Int}
        Ind_v::Vector{Int}
        Shift_x::Vector{Vector{Float64}}
        Value_u::Vector{Float64}
        Value_v::Vector{Float64}
    end
    RSOCData() = RSOCData(Vector{Vector{Int}}[], Int[], Int[], Vector{Vector{Float64}}[], Float64[], Float64[])

    struct InequalityData
        A::SparseMatrixCSC{Float64, Int}
        rhs_c::Vector{Float64}         # Ax <= c
        Ind_Box::Vector{Int}           # Indici variabili soggette a clamp (l <= x <= u)
        rhs_BoxMin::Vector{Float64}    # Limite inferiore
        rhs_BoxMax::Vector{Float64}    # Limite superiore
        Ind_NonNeg::Vector{Int}        # Indici variabili x >= 0 (ottimizzazione specifica)
    end
    InequalityData() = InequalityData(spzeros(0,0), Float64[], Int[], Float64[], Float64[], Int[])

    struct SolverResult
        x::Vector{Float64}
        z::Union{Matrix{Float64}, Vector{Float64}, Nothing} # Dipende da come gestisci z globalmente
        converged::Bool
        iterations::Int
        r_norm::Float64
        s_norm::Float64
    end

    struct Problem
        H::Matrix{Float64}                     # Matrice Hessiana
        q::Vector{Float64}                     # Vettore lineare (costo)
        F::Union{Matrix{Float64}, Nothing}     # Vincoli uguaglianza Matrix
        g::Union{Vector{Float64}, Nothing}     # Vincoli uguaglianza RHS
        Soc::SOCData
        Rsoc::RSOCData
        Ineq::InequalityData
    end

    # ==============================================================================
    # 2. CREAZIONE DEL PROBLEMA (DA MINI JUMP)
    # ==============================================================================

    """
        ProblemCreator(H, q, F, g, A, b, lb, ub, socs)

    Converte le matrici grezze estratte da MiniJuMP nelle strutture dati ottimizzate per ADMM.
    """
    function ProblemCreator(H::AbstractMatrix, q::AbstractVector,
                            F::Union{AbstractMatrix, Nothing}, g::Union{AbstractVector, Nothing},
                            A::Union{AbstractMatrix, Nothing}, b::Union{AbstractVector, Nothing},
                            lb::Union{AbstractVector, Nothing}, ub::Union{AbstractVector, Nothing},
                            socs::Vector)

        n = length(q)

        # --- 1. GESTIONE VINCOLI CONICI  ---
        ind_soc_vec = Vector{Vector{Int}}()
        ind_t_soc = Int[]
        t_Soc = Vector{Float64}()

        
        # Iteriamo sulle tuple (A, b, c, d) restituite da MiniJuMP
        for s in socs
            A_cone = s[1] # Matrice (parte vettoriale)
            # s[2] è b_cone (ignorato se assumiamo ||x|| <= t puro)
            c_cone = s[3] # Vettore (parte scalare)
            # s[4] è d_cone
            d_cone = s[4]

            # A. Trovare indici variabili vettoriali (||x||)
            # Cerchiamo le colonne di A_cone che non sono nulle.
            # sum(abs, ...) schiaccia le righe. Se una colonna ha somma > 0, la variabile è usata.
            vec_idxs = findall(x -> x > 1e-9, vec(sum(abs, A_cone, dims=1)))
            
            # B. Trovare indice variabile scalare (<= t)
            # Cerchiamo l'elemento non nullo in c_cone
            scalar_idxs = findall(x -> abs(x) > 1e-9, c_cone)
            
            if !isempty(vec_idxs) && !isempty(scalar_idxs)
                push!(ind_soc_vec, vec_idxs)
                push!(ind_t_soc, scalar_idxs[1])
                push!(t_Soc, d_cone)

            elseif !isempty(vec_idxs) && isempty(scalar_idxs)
                push!(ind_soc_vec, vec_idxs)
                push!(t_Soc, d_cone)

            else
                error("❌ Errore nella definizione del cono SOC: indici non trovati correttamente.")    
            end
 
        end

        Soc = SOCData(ind_soc_vec, ind_t_soc, t_Soc)

        # Placeholder per RSOC (non presenti in MiniJuMP standard)
        Rsoc = RSOCData()

        # --- 2. Gestione Disuguaglianze Generiche ---
        A_mat = (A === nothing) ? spzeros(0, n) : sparse(A)
        b_vec = (b === nothing) ? Float64[] : Vector{Float64}(b)

        # --- 3. Gestione Bounds (Box vs NonNeg) ---
        Ind_Box = Int[]
        BoxMin = Float64[]
        BoxMax = Float64[]
        Ind_NonNeg = Int[]

        if lb !== nothing && ub !== nothing
            for i in 1:n
                l_val = lb[i]
                u_val = ub[i]

                # Ignora variabili senza vincoli (-Inf, +Inf)
                if l_val == -Inf && u_val == Inf
                    continue
                end

                # Caso Non-Negatività Pura: x >= 0 (con u = +Inf)
                if l_val == 0.0 && u_val == Inf
                    push!(Ind_NonNeg, i)
                else
                    # Caso Box Generico (inclusi x >= k o x <= k)
                    # Sostituiamo Inf con valori numerici "sicuri" per il clamp se necessario
                    # ma Julia clamp gestisce Inf correttamente.
                    push!(Ind_Box, i)
                    push!(BoxMin, l_val)
                    push!(BoxMax, u_val)
                end
            end
        end

        Ineq = InequalityData(A_mat, b_vec, Ind_Box, BoxMin, BoxMax, Ind_NonNeg)

        # Gestione Uguaglianze Vuote
        F_mat = (F === nothing || isempty(F)) ? zeros(0, n) : Matrix{Float64}(F)
        g_vec = (g === nothing || isempty(g)) ? zeros(0) : Vector{Float64}(g)


        problem = Problem(Matrix{Float64}(H), Vector{Float64}(q), F_mat, g_vec, Soc, Rsoc, Ineq)
        return problem
    end

    # ==============================================================================
    # 3. INTERFACCIA SOLVE
    # ==============================================================================

    """
        solve(prob::Problem; kwargs...)

    Funzione wrapper principale per risolvere il problema ADMM.
    """
    function solve(Problem::Problem; 
                x0::Union{Vector{Float64}, Nothing}=nothing,
                ρ=1.0, α=1.0, max_iter=1000, tol=1e-4, verbose=true)

        # Inizializzazione x0 se non fornito
        n = size(Problem.H, 1)
        if x0 === nothing
            x0_vec = zeros(n)
        else
            x0_vec = x0
        end

        if verbose
            println("🔵 Avvio ADMM Solver...")
            println("   Dimensioni variabili: $n")
            println("   Coni SOC: $(length(Problem.Soc.Ind_Soc))")
            println("   Vincoli Box: $(length(Problem.Ineq.Ind_Box))")
        end

        # Chiamata al core solver
        x_opt, z_opt = admm_socp(Problem, x0 = x0_vec, ρ = ρ, α = α, max_iter=max_iter, tol=tol)

        if verbose
            println("🏁 Solver terminato.")
        end

        return x_opt, z_opt
    end

    # ==============================================================================
    # 4. IMPLEMENTAZIONE CORE (admm_socp)
    # ==============================================================================

    function proj_soc(u::AbstractVector, t::Real, fixed_t::Bool)
        if !fixed_t
            nx = norm(u)
            if nx <= t
                return copy(u), t
            elseif nx <= -t
                return zeros(length(u)), 0.0
            else
                val = (nx + t) / (2 * nx)
                return val * u, val * nx
            end
        else
            # Caso t fisso
            nx = norm(u)
            if nx <= t
                return copy(u), t
            else
                return (t / nx) * u, t
            end
        end
    end

    function proj_polytope(x, A, c)
        # Placeholder: proiezione su politopo generico è complessa.
        # Spesso in ADMM si converte Ax <= c in Ax + s = c, s >= 0
        # Qui gestiamo solo il caso banale o assumiamo slack già inserite.
        return x
    end

function admm_socp(Problem::Problem; 
                       x0::Vector{Float64}=zeros(size(Problem.H,1)),
                   ρ=1.0, α = 1.0, max_iter=200, ε_abs = 1e-5, ε_rel = 1e-5, tol=1e-1)

        Box_ind, A, c, Ind_NonNeg, rhs_BoxMin, rhs_BoxMax = Problem.Ineq.Ind_Box, Problem.Ineq.A, Problem.Ineq.rhs_c, Problem.Ineq.Ind_NonNeg, Problem.Ineq.rhs_BoxMin, Problem.Ineq.rhs_BoxMax
        H, F, g, Soc, Rsoc, obj = Problem.H, Problem.F, Problem.g, Problem.Soc, Problem.Rsoc, Problem.q



        # ------------------------
        # Dimensioni del problema
        # ------------------------
        n  = length(x0)             # dimensione delle variabili
        m  = length(Soc.Ind_Soc)    # numero di vincoli conici
        mv = length(Soc.Ind_t_Soc)  # numero di vincoli conici con variabile t
        r  = length(Rsoc.Ind_x)
        ru = length(Rsoc.Ind_u)
        rv = length(Rsoc.Ind_v)
        nu = length(Box_ind)          # numero di variabili con clamp
        na = length(c)
        
        H = copy(H)
        F = copy(F)
        obj = copy(obj)
        x0 = copy(x0)
        ρ = copy(ρ)

        if na > 0
            # Aggiungi i vincoli di ineguaglianza generali alla matrice A
            A = hcat(A,zeros(na, na))
            for i in 1:na
                A[i, n + i] = 1.0  # variabile slack
                Ind_NonNeg = vcat(Ind_NonNeg, n + i)  # aggiungi variabile slack ai non-negativi
            end

            F = hcat(F, zeros(size(F, 1), size(A, 2) - size(F, 2)))
            F = vcat(F, A)
            g = vcat(g, c)
            # Espandi il vettore dei costi c per le nuove variabili slack
            obj = vcat(obj, zeros(na))
            H = [H zeros(n,na); zeros(na, n+na)]
            x0  = vcat(x0, zeros(na))
        end

        nn = length(Ind_NonNeg)
        na_copy = na
        na = 0

        # ==========================================================
        # 🔹 Equilibration
        # ==========================================================
        # H, F, g, Soc, Rsoc, Ineq, D, E = equilibrate_data(H, F, g, Soc, Rsoc, Ineq)

        # # scala variabili iniziali e costo
        # x0 = E .* x0
        # obj = E .* obj

        # ------------------------
        # Variabili primali/dual
        # ------------------------
        x = copy(x0)

        # SOC
        z = m>0 ? zeros(n + na_copy, m) : zeros(0,0)
        u = m>0 ? zeros(n + na_copy, m) : zeros(0,0)

        # RSOC
        zR = r>0 ? zeros(n + na_copy, r) : zeros(0,0)
        uR = r>0 ? zeros(n + na_copy, r) : zeros(0,0)

        # disuguaglianze
        zA = na>0 ? zeros(n) : zeros(0)
        uA = na>0 ? zeros(n) : zeros(0)

        # clamp
        zU = nu>0 ? zeros(nu) : zeros(0)
        uU = nu>0 ? zeros(nu) : zeros(0)

        zN = nn>0 ? zeros(nn) : zeros(0)
        uN = nn>0 ? zeros(nn) : zeros(0)

        z_prev = copy(z)
        zR_prev = copy(zR)
        zU_prev = copy(zU)
        zN_prev = copy(zN)
        zA_prev = copy(zA)

        rhs = zeros(n + na_copy + length(g))


        # 1️⃣ Contributo vincoli conici
        # SOC
        if m > 0
            for i in 1:m
                idx_vec = Soc.Ind_Soc[i]
                H[idx_vec, idx_vec] += ρ * I(length(idx_vec))
            end
            if mv > 0
                for i in 1:mv
                    idx_scal = Soc.Ind_t_Soc[i]
                    H[idx_scal, idx_scal] += ρ
                end
            end
        else
            sum_z_u = zeros(n)
        end

        # RSOC
        if r > 0
            for i in 1:r
                idx_vec = Rsoc.Ind_x[i]
                H[idx_vec, idx_vec] += ρ*I(length(idx_vec))
            end
            if ru > 0
                for i in 1:ru
                    idx_u   = Rsoc.Ind_u[i]
                    H[idx_u, idx_u] += ρ
                end
            end
            if rv > 0
                for i in 1:rv
                    idx_v   = Rsoc.Ind_v[i]
                    H[idx_v, idx_v] += ρ
                end
            end
        end

        # 2️⃣ Contributo vincoli di disuguaglianza Ax ≤ c
        if  na > 0
            for i in 1:n
                H[i,i] += ρ
            end
        end
    
        # 3️⃣ Contributo vincoli clamp
        if nu > 0
            for i in Box_ind
                H[i,i] += ρ
            end
        end

        if nn > 0
            for i in Ind_NonNeg
                H[i,i] += ρ
            end
        end

        # # ------------------------
        # # Fattorizzazioni (con o senza vincoli di uguaglianza)
        # # ------------------------
        if F === nothing && size(F,1) == 0
            Hx_fact = factorize(H)
        else
            # KKT = [Hx F'; F zeros(size(F,1), size(F,1))]
            KKT = [H F'; F zeros(size(F,1), size(F,1))]
            @time KKT_fact = lu(sparse(KKT))

            # error("KKT Factorization to be implemented")
        end

        # ==========================================================
        # Iterazioni ADMM
        # ==========================================================
        for k in 1:max_iter

            # ------------------------
            # x-update
            # ------------------------
            extra_term = zeros(n + na_copy)

            # vincoli di disuguaglianza
            if na > 0
                @views extra_term .+= zA - uA
            end

            # clamp
            if nu > 0
                @views extra_term[Box_ind] .+= zU - uU
            end

            # non negatività
            if nn > 0
                @views extra_term[Ind_NonNeg] .+= zN - uN   
            end

            # Coni
            if m > 0
                sum_z_u = zeros(n+na_copy)
                for j in 1:m
                    @views sum_z_u .+= z[:,j] .- u[:,j]
                end
            end

            if r>0
                if m<1
                    sum_z_u = zeros(n+na_copy)
                end

                for j in 1:r
                    sum_z_u .+= zR[:,j] - uR[:,j]
                end
            end

            # RHS per il sistema lineare
            f = ρ*sum_z_u + ρ*extra_term - obj

            # # RHS per il sistema lineare
            # @views @. f = ρ*(z - u) - obj



            if  size(F,1) != 0
                # Risoluzione sistema KKT (con vincoli Fx = g)
                rhs[1:length(f)] .= f
                rhs[length(f)+1:end] .= g   
                sol = KKT_fact \ rhs
                @views x = sol[1:(n+na_copy)]
            else
                # Caso senza vincoli di uguaglianza
                x = Hx_fact \ f
            end


            if any(isnan.(x))
                break 
            end
            # if k==3
            #     break
            # end
            # if  size(F,1) != 0
            #     # Risoluzione sistema KKT (con vincoli Fx = g)
            #     rhs = vcat(f, g)
            #     sol = KKT_fact \ rhs
            #     x = sol[1:n+na_copy]
            # else
            #     # Caso senza vincoli di uguaglianza
            #     x = Hx_fact \ f
