    # ==============================================================================
    # 1. STRUTTURE DATI (TYPES)
    # ==============================================================================

    struct SOCData
        Ind_Soc::Vector{Vector{Int}}   # Indici delle variabili vettoriali (x)
        Ind_t_Soc::Vector{Int}         # Indici delle variabili scalari (t)
        t_Soc::Vector{Float64}         # Valori fissi di t (se costanti)
    end
    # SOCData() = SOCData(Vector{Vector{Int}}[], Int[], Float64[])

    struct RSOCData
        Ind_x::Vector{Vector{Int}}
        Ind_u::Vector{Int}
        Ind_v::Vector{Int}
        Shift_x::Vector{Vector{Float64}}
        Value_u::Vector{Float64}
        Value_v::Vector{Float64}
    end
    RSOCData() = RSOCData(Vector{Vector{Int}}[], Int[], Int[], Vector{Vector{Float64}}[], Float64[], Float64[])

    struct InequalityData
        A::SparseMatrixCSC{Float64, Int}
        rhs_c::Vector{Float64}         # Ax <= c
        Ind_Box::Vector{Int}           # Indici variabili soggette a clamp (l <= x <= u)
        rhs_BoxMin::Vector{Float64}    # Limite inferiore
        rhs_BoxMax::Vector{Float64}    # Limite superiore
        Ind_NonNeg::Vector{Int}        # Indici variabili x >= 0 (ottimizzazione specifica)
    end
    InequalityData() = InequalityData(spzeros(0,0), Float64[], Int[], Float64[], Float64[], Int[])

    # --- Data Structures ---
    struct RiccatiSystem
        A::Vector{Matrix{Float64}}
        B::Vector{Matrix{Float64}}
        c::Vector{Vector{Float64}}
        idx_x::Vector{Vector{Int}}
        idx_u::Vector{Vector{Int}}
        
        # Info per Hard Constraint x0
        x0_fixed_vals::Vector{Float64} # Valori fisici
        x0_fixed_idxs::Vector{Int}     # Indici relativi nello stato aumentato (es. 1:13)
    end

    struct RiccatiFactorization
        P::Vector{Matrix{Float64}}      # Matrici Cost-to-Go
        K::Vector{Matrix{Float64}}      # Guadagni di feedback
        L::Vector{Vector{Float64}}      # Termini lineari feedforward (vettori)
        # Matrici pre-calcolate per efficienza (es. inverso di (R + B'PB))
        Psi_inv::Vector{Matrix{Float64}} 
        Q::Vector{Matrix{Float64}}      # Hessiane estratte localmente
        R::Vector{Matrix{Float64}}
        M::Vector{Matrix{Float64}}      # Cross-terms (se presenti nella Hessiana globale)
    end

    struct SolverResult
        x::Vector{Float64}
        z::Union{Matrix{Float64}, Vector{Float64}, Nothing} # Dipende da come gestisci z globalmente
        converged::Bool
        iterations::Int
        r_norm::Float64
        s_norm::Float64
    end


    struct Problem
        H::Matrix{Float64}                     # Matrice Hessiana
        q::Vector{Float64}                     # Vettore lineare (costo)
        F::Union{Matrix{Float64}, Nothing}     # Vincoli uguaglianza Matrix
        g::Union{Vector{Float64}, Nothing}     # Vincoli uguaglianza RHS
        Soc::SOCData
        Rsoc::RSOCData
        Ineq::InequalityData
        Riccati::Union{RiccatiSystem, Nothing}
    end

    mutable struct WarmStartData
        # Variabili Primali
        x::Vector{Float64}
        
        # Variabili Duali (u) e Ausiliarie (z) per ogni blocco
        # SOC
        z_soc::Matrix{Float64}
        u_soc::Matrix{Float64}
        
        # RSOC
        z_rsoc::Matrix{Float64}
        u_rsoc::Matrix{Float64}
        
        # Disuguaglianze Generiche (Ax <= c)
        z_A::Vector{Float64}
        u_A::Vector{Float64}
        
        # Box (Clamp)
        z_Box::Vector{Float64}
        u_Box::Vector{Float64}
        
        # NonNeg (x >= 0)
        z_NonNeg::Vector{Float64}
        u_NonNeg::Vector{Float64}

        # Parametro rho (se adattivo, altrimenti resta fisso)
        rho::Float64
    end

    # Costruttore vuoto (o per inizializzazione zero)
    function WarmStartData(n::Int, m::Int, r::Int, na::Int, nu::Int, nn::Int)
        return WarmStartData(
            zeros(n),               # x
            zeros(n, m), zeros(n, m),     # SOC (z, u) - nota: n qui include slack se usate, meglio controllare dimensione
            zeros(n, r), zeros(n, r),     # RSOC
            zeros(na), zeros(na),         # Ineq
            zeros(nu), zeros(nu),         # Box
            zeros(nn), zeros(nn),         # NonNeg
            1.0                           # rho default
        )
    end

    # ==============================================================================
    # 2. CREAZIONE DEL PROBLEMA (DA MINI JUMP)
