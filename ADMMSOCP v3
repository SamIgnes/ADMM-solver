    """
        ProblemCreator(H, q, F, g, A, b, lb, ub, socs)

    Converte le matrici grezze estratte da MiniJuMP nelle strutture dati ottimizzate per ADMM.
    """
    function ProblemCreator(m::MiniJuMP.Model)

        # 1. Estrai matrici standard (H, q, F, g, A, b...)
        H, q, F, g, A, b, lb, ub, socs = MiniJuMP.extract_matrices(m)

        # 2. Gestione Bounds e Coni (Come prima)
        # ... (Copia il blocco "Ind_Box", "Soc" dal codice precedente) ...
        # Ricostruzione rapida per completezza:
        ind_soc_vec = Vector{Vector{Int}}(); ind_t_soc = Int[]; t_Soc = Vector{Float64}()
        for s in socs
            A_c, _, c_c, d_c = s
            vec_idxs = findall(x -> x > 1e-9, vec(sum(abs, A_c, dims=1)))
            scalar_idxs = findall(x -> abs(x) > 1e-9, c_c)
            if !isempty(vec_idxs)
                push!(ind_soc_vec, vec_idxs)
                if !isempty(scalar_idxs); push!(ind_t_soc, scalar_idxs[1]); push!(t_Soc, d_c)
                else; push!(t_Soc, d_c); end
            end
        end
        Soc = ADMMSOCP.SOCData(ind_soc_vec, ind_t_soc, t_Soc)
        
        Ind_Box = Int[]; BoxMin = Float64[]; BoxMax = Float64[]; Ind_NonNeg = Int[]
        for i in 1:length(q)
            l, u = lb[i], ub[i]
            if l == 0.0 && u == Inf; push!(Ind_NonNeg, i)
            elseif l > -1e19 || u < 1e19
                push!(Ind_Box, i); push!(BoxMin, max(l, -1e9)); push!(BoxMax, min(u, 1e9))
            end
        end
        Ineq = ADMMSOCP.InequalityData(sparse(A), Vector{Float64}(b), Ind_Box, BoxMin, BoxMax, Ind_NonNeg)
        
        # 3. GENERAZIONE AUTOMATICA RICCATI DA @dynamics
        riccati_sys = nothing
        
        if m.dynamics !== nothing
            dyn = m.dynamics
            raw_x_idxs, shape_x = m.var_info[dyn.state_name]
            raw_u_idxs, shape_u = m.var_info[dyn.input_name]
            idx_x_cols = reshape(raw_x_idxs, shape_x) 
            idx_u_cols = reshape(raw_u_idxs, shape_u)
            
            # Recuperiamo x0 se presente
            x0_val = dyn.x0 

            # Check for State Reset Logic
            if haskey(dyn.settings, :phases) && haskey(dyn.settings, :time_var)
                N_phase = Int(dyn.settings[:phases])
                tf_sym  = dyn.settings[:time_var]
                
                if haskey(m.var_info, tf_sym)
                    raw_tf_idxs, _ = m.var_info[tf_sym]
                    riccati_sys = build_augmented_riccati_reset(dyn.A_list, dyn.B_list, dyn.c_list, idx_x_cols, idx_u_cols, raw_tf_idxs, N_phase, x0_val)
                else
                    error("❌ Time variable :$tf_sym not found in model variables.")
                end
            else
                # Standard
                idx_x_all = [idx_x_cols[:, k] for k in 1:size(idx_x_cols, 2)]
                idx_u_all = [idx_u_cols[:, k] for k in 1:size(idx_u_cols, 2)]
                
                x0_fixed_vals = (x0_val === nothing) ? Float64[] : x0_val
                x0_fixed_idxs = (x0_val === nothing) ? Int[] : collect(1:length(x0_val))
                
                riccati_sys = RiccatiSystem(dyn.A_list, dyn.B_list, dyn.c_list, idx_x_all, idx_u_all, x0_fixed_vals, x0_fixed_idxs)
            end
        end

        # Placeholder per RSOC
        Rsoc = ADMMSOCP.RSOCData()

        return ADMMSOCP.Problem(H, q, F, g, Soc, Rsoc, Ineq, riccati_sys)
    end

    # --------------------------------------------------------------------------
    # BUILDER SISTEMA AUMENTATO (CON X0)
    # --------------------------------------------------------------------------
    function build_augmented_riccati_reset(Ad_list, Bd_list, cd_list, idx_x_cols, idx_u_cols, idx_tf, N_phase, x0_phys)
        
        N = length(Ad_list)
        nx_phys = size(Ad_list[1], 1)       # 13
        nu_phys = size(Bd_list[1], 2) - 1   # 4
        
        nu_aug_model = size(idx_u_cols, 1) 
        ns_slack = nu_aug_model - nu_phys - 1
        nx_riccati = nx_phys + 1            # 14
        
        A_list_aug = Matrix{Float64}[]
        B_list_aug = Matrix{Float64}[]
        c_list_aug = Vector{Float64}[]
        
        idx_x_all = Vector{Vector{Int}}()
        idx_u_all = Vector{Vector{Int}}()
        
        for k in 1:N
            # ... (Logica Loop identica alla tua versione originale) ...
            # Calcolo Gate
            curr_gate = div(k-1, N_phase) + 1
            next_gate = div(k, N_phase) + 1
            if next_gate > length(idx_tf); next_gate = length(idx_tf); end
            
            Ad, Bd, cd = Ad_list[k], Bd_list[k], cd_list[k]
            B_phys_dyn = Bd[:, 1:nu_phys]
            B_tf_dyn   = Bd[:, end] 
            
            # Aumentata A (14x14)
            Aa = zeros(nx_riccati, nx_riccati)
            Aa[1:nx_phys, 1:nx_phys] = Ad
            Aa[1:nx_phys, end] = B_tf_dyn 
            
            # Reset Logic
            is_switch = (k % N_phase == 0) && (k < N)
            if is_switch; Aa[end, end] = 0.0; else; Aa[end, end] = 1.0; end
            
            # Aumentata B (14x18)
            Ba = zeros(nx_riccati, nu_aug_model)
            Ba[1:nx_phys, 1:nu_phys] = B_phys_dyn
            if ns_slack > 0
                rows_slack = min(nx_phys, ns_slack)
                Ba[1:rows_slack, nu_phys+1:nu_phys+rows_slack] = I(rows_slack)
            end
            
            # Reset Logic su B
            if is_switch; Ba[end, end] = 1.0; else; Ba[end, end] = 0.0; end
            
            ca = zeros(nx_riccati); ca[1:nx_phys] = cd
            push!(A_list_aug, Aa); push!(B_list_aug, Ba); push!(c_list_aug, ca)
            
            # Indices
            real_v_idx = is_switch ? idx_tf[next_gate] : idx_tf[curr_gate]
            current_x_indices = [idx_x_cols[:, k]; idx_tf[curr_gate]]
            u_indices_model = idx_u_cols[:, k]
            current_u_indices = [u_indices_model[1:end-1]; real_v_idx]
            push!(idx_x_all, current_x_indices); push!(idx_u_all, current_u_indices)
        end
        
        # Final State Indices
        final_gate = div(N, N_phase) + 1
        if final_gate > length(idx_tf); final_gate = length(idx_tf); end
        final_x_indices = [idx_x_cols[:, N+1]; idx_tf[final_gate]]
        push!(idx_x_all, final_x_indices)
        
        # --- MODIFICA CHIAVE QUI SOTTO ---
        # Fissiamo SOLO la parte fisica. Lasciamo il tempo (ultimo indice) LIBERO.
        if x0_phys !== nothing
            x0_fixed_vals = x0_phys
            x0_fixed_idxs = collect(1:nx_phys) # Indici 1..13
            # NOTA: Non includiamo nx_riccati (14) qui!
        else
            x0_fixed_vals = Float64[]
            x0_fixed_idxs = Int[]
        end
        
        return ADMMSOCP.RiccatiSystem(A_list_aug, B_list_aug, c_list_aug, idx_x_all, idx_u_all, x0_fixed_vals, x0_fixed_idxs)
    end

    # ### NEW: Estrae i blocchi Q, R, M dalla Hessiana globale sparsa ###
    function extract_local_hessians(H::AbstractMatrix, ric::RiccatiSystem)
        N = length(ric.A) # Numero di step di controllo
        Q_list = Matrix{Float64}[]
        R_list = Matrix{Float64}[]
        M_list = Matrix{Float64}[] # Cross term x'Hu

        # Nota: idx_x ha N+1 elementi (x_0 ... x_N)
        #       idx_u ha N elementi (u_0 ... u_{N-1})
        
        for k in 1:N
            ix = ric.idx_x[k]
            iu = ric.idx_u[k]
            
            # Estrazione sottomatrici dalla Hessiana globale
            push!(Q_list, H[ix, ix])
            push!(R_list, H[iu, iu])
            push!(M_list, H[ix, iu]) # Termini misti (spesso zero)
        end
        # Ultimo step (solo stato finale)
        ix_f = ric.idx_x[N+1]
        push!(Q_list, H[ix_f, ix_f])
        
        return Q_list, R_list, M_list
    end


